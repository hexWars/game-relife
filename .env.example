# ============================================================
# 滴答清单官方 MCP 令牌
#   获取：网页版滴答清单 → 右上角头像 → 设置 → 账户与安全 → API 口令 → 创建
#   本地：把真实值写进 .claude/settings.local.json（已 gitignore，见该文件）
#   CI：  GitHub 仓库 → Settings → Secrets and variables → Actions
#        新增 Secret 名称 DIDA_MCP_TOKEN，值填真实口令
# ============================================================
DIDA_MCP_TOKEN=dp_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# DeepSeek API Key（Claude Code 走 DeepSeek 的 Anthropic 兼容端点）
#   获取：https://platform.deepseek.com/api_keys
#   CI：  新增 Secret 名称 DEEPSEEK_API_KEY
#   Claude Code 连 DeepSeek 需要这组环境变量（本地已配好，
#   CI 里 workflow 中已设置，改模型只需改 workflow 的 ANTHROPIC_MODEL）：
#     ANTHROPIC_BASE_URL = https://api.deepseek.com/anthropic
#     ANTHROPIC_AUTH_TOKEN = <DeepSeek Key>
#     ANTHROPIC_MODEL = deepseek-v4-flash
# ============================================================
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
