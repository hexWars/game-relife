---
import '../styles/global.css';
import LifePanel from '../components/LifePanel';
import type { StatsFile } from '../lib/types';
import rawStats from '../../data/stats.json';

const stats = rawStats as StatsFile;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>人生系统面板 · Life System</title>
    <meta name="description" content="游戏化生活面板：魅力 / 智力 / 体力 / 精神" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Noto+Sans+SC:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <LifePanel client:load stats={stats} />
  </body>
</html>
