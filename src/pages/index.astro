---
import '../styles/global.css';
import LifePanel from '../components/LifePanel';
import type { TasksFile } from '../lib/types';
import { deriveStats } from '../lib/derive';
import rawTasks from '../../data/tasks.json';

const stats = deriveStats(rawTasks as TasksFile);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>地球online 系统面板 · Life System</title>
    <meta name="description" content="游戏化生活面板：魅力 / 智力 / 体力 / 精神" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;700;900&family=Noto+Sans+SC:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <LifePanel client:load stats={stats} />
  </body>
</html>
